# Server configuration
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL / Supabase connection string
# Replace with your actual Supabase connection URI in your local .env file.
# Never commit real credentials or paste secrets into source control.
#
# Examples:
# Direct connection (Session mode):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Connection Pooler (Transaction mode, recommended for serverless/pooled connections):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT Authentication Secret
# Must be at least 32 characters (256 bits) of entropy.
# Example generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-at-least-32-chars-jwt-secret
JWT_EXPIRES_IN=8h

# Auth Bootstrap (Optional: used by npm run bootstrap:auth in non-interactive/CI mode)
# BOOTSTRAP_ADMIN_PASSWORD=your-super-admin-password
# BOOTSTRAP_STAFF_PASSWORD=your-bureau-staff-password

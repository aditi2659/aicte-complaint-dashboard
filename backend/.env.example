# AICTE Complaint Monitoring Dashboard - Backend Environment Configuration

# Server Environment
PORT=4000
NODE_ENV=development

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection String (Direct Connection or Transaction Pooler)
# Supabase Transaction Pooler URL format (recommended for serverless/pooled connections):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Dedicated isolated test database connection string (REQUIRED for running backend tests)
# Tests will refuse to run against the shared DATABASE_URL to prevent test contamination.
# Example local PostgreSQL test database:
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_complaints_test
TEST_DATABASE_URL=

# JWT Authentication Secret
# Must be at least 32 characters (256 bits) of entropy.
# Example generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-at-least-32-chars-jwt-secret
JWT_EXPIRES_IN=8h

# Bootstrap account passwords
BOOTSTRAP_ADMIN_PASSWORD=replace_with_admin_password
BOOTSTRAP_STAFF_PASSWORD=replace_with_staff_password
